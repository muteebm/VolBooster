{
  "name": "volbooster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/set-electron-icon.mjs && concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "loudness": "^0.4.2",
    "native-sound-mixer": "^3.4.6-win",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "rcedit": "^5.0.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "author": "Headroom",
  "description": "Windows system volume, EQ, and gain control",
  "build": {
    "appId": "com.volbooster.pro",
    "productName": "Headroom",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Headroom",
      "uninstallDisplayName": "Headroom",
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "muteebm",
      "repo": "VolBooster"
    }
  }
}
